<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebAppBackend.Api</RootNamespace>
    <AssemblyName>WebAppBackend.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Content\backup.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensures the XML content file is copied next to the executable / published output
         and that changes made to it on disk are picked up without recompiling. -->
    <None Include="Content\site-content.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
	<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
